<main>
  <%-include('./chatrooms')%>
  <div class="chat">
    <h1>Welcome to #<%=chatroom%>!</h1>
    <%if (!user) {%>
    <h2>To make posts or view users, please sign in.</h2>
    <%} else {%>
    <h3 class="login-user">You are logged in as: <%=user.username%></h3>

    <%}%> <% if (user) {%>
    <a class="new-message" href="<%=chatroom%>/new-message">Create a new message</a>
    <%}%>

    <hr />
    <div class="message-wrapper">
      <%messages.forEach((message) => { %>
      <div class="message">
        <div class="user-details">
          <div class="username"><%= user ? message.username : '*****';%></div>
          <div class="date"><%= user ? message.created_at : '****** ***** *********';%></div>
        </div>
        <div class="title"><%=message.title%></div>
        <div class="text"><%=message.message%></div>

        <% if (message.image) {%>
        <img src="<%=message.image%>" alt="Image" />
        <%}%>
      </div>
      <%})%>
    </div>
  </div>
</main>
